			public function generate_passport_signature($users_id){
					$students = new card();
					$func = new functions();
					
					foreach($users_id as $sn){ 
						$my_info = $func->resort($this->search_card(array('sn'=>$sn)));	
						 
					   $pic_name = str_replace("/","",$my_info['regno']); 
					   $my_session = str_replace("/","",$my_info['session']); 
					   
					   $psp_dir = "../imgs/".$my_session."/passports/";
					   $sign_dir = "../imgs/".$my_session."/signatures/";
					   
					   $this->update_card(array('passport'=>$pic_name,'signature'=>$pic_name,'psp_dir'=> $psp_dir,'sign_dir'=>$sign_dir),array('sn'=>$sn));
					} 
				 return count($users_id)." student's passport and signature name has been generated successfully ";
		}
		
