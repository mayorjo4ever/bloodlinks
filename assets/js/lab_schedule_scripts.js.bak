	 /*************************************/
		function del_specimen_template(data_text) {				
			infos = data_text.split('|'); // temp result name | bill type | bill_type_id | serial  
			 elem = $('#result_template'); 
			 /********/
			swal({icon:'warning',title: ' Delete '+infos[0]+' ? ', closeOnEsc:false,closeOnClickOutside:false,				 
			buttons: {
			  cancel: {
				text: "Cancel",value: null,visible: true,
				closeModal: true,
			  },
			  confirm: {
				text: "Yes, Delete!", value: true,visible: true,
				closeModal: false
			  }
			},
			text:"About Deleting "+infos[0]+", under "+infos[1],dangerMode:true})
			.then((value) => {
			  if(value) {
				/** when confirmed.. send to server **/
				/**********************************************/
				var req = $.ajax({url : "temp_formsubmit.php",method : "POST",data:{ del_specimen_template:"this",serial:infos[3],name:infos[0]},beforeSend:function(){console.log(data_text)}  	});
				req.fail(function(e){  console.log(e.status+" Failed"); });
				req.done(function(res){   // alert(res);
					  var output = $.parseJSON(res);
						 swal({title:output['title'],text:output['text'],icon:output['icon']})
						 .then((next)=>{
							 if(output['icon']=="success"){
								 view_bill_result_template(infos[2],elem); 		// bill_type_id , elem 						 
							 }
						 });	
				 }); 
				/**********************************************/				
			  } 
			});
	 } 
