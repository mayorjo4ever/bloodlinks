	function display_temp_form_type(type="all"){
			$('div.form-group.all').hide('fast'); 
			$('div.form-group.'+type).show('fast');  			
			if(type=="param_form"){ reload_unit_tinymce();   }
			else if (type=="text_form"){ reload_text_tinymce(); } 
	}
	
	/*************************************/
	function display_search_type(type="all"){
			$('div.all').hide('fast'); 
			$('div.'+type).show('fast');  			
			// if(type=="param_form"){ reload_unit_tinymce();   }
			// else if (type=="text_form"){ reload_text_tinymce(); } 
	}
	
	function maximize_win(elem){
		// elem.removeClass('col-md-6').addClass('col-md-12');
		elem.toggleClass('col-md-12');
	}
	
	/*** when viewing inputed text for specimen result  *********/
	function display_my_raw_text_submit(data_text,elem){
			var req = $.ajax({ 
				url:"formsubmit.php", data:{ display_my_raw_text_submit:'this',info:data_text}, method:"POST",beforeSend:function(){  elem.html("<i class='fa fa-spinner fa-spin fa-3x'></i>"); console.log('sending request :'+data_text); }}); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){   // alert(res);    
					 elem.html(res);
				   }); 
	}
	
	/*** when saving inputed text for specimen result  *********/
	function load_user_system_temp_values(data_text,elem){
			var req = $.ajax({ 
				url:"formsubmit.php", data:{ load_user_system_temp_values:'this',info:data_text}, method:"POST",beforeSend:function(){ console.log('sending request :'); }}); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){   // alert(res);    
					$('button#save_specimen_text_result_btn').attr('data-text',data_text);
					var output = $.parseJSON(res);
					$('#date_perform_text').val(output['date_perform']);
				// initialize the text area 
				if(tinymce.execCommand('mceRemoveEditor', false, elem)) {
					tinymce.init({
					  selector: 'textarea#'+elem, 
					  height:600, 
					  plugins: [
						'advlist autolink lists link image charmap print preview hr anchor pagebreak',
						'searchreplace wordcount visualblocks visualchars code fullscreen',
						'insertdatetime media nonbreaking save table directionality',
						'emoticons template paste textpattern imagetools codesample toc help'
					  ],
					  toolbar1: 'undo redo | insert | styleselect | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image',
					  toolbar2: 'print preview media | forecolor backcolor emoticons | codesample help',
					}); 
				}
				// now load the content 
				var ed = tinymce.activeEditor;
					ed.setProgressState(1);
					window.setTimeout(function(){  
					   ed.setProgressState(0); 
					   ed.setContent(output['text']); 					
					},2000);
							 
				   }); 
		}
		
	
	$(document).on('focusin',function(e){
		if($(e.target).closest(".mce-window, .tox-tinymce-aux, .moxman-window, .tam-assetmanager-root").length){
			e.stopImmediatePropagation();
		}
	});