	 function display_form(){
		  elem = $("input:checkbox#view_mode,input:checkbox#view_mode_2"); 
				  if(elem.prop('checked')){
					$('div.search').show(); $('div.selection').hide(); }
					else  {  $('div.search').hide(); $('div.selection').show(); }  
	 }
	 
	 function add_this_specimen(serial,elem_spec){ 
		
		 if(elem_spec.val()==""){  loader('hide');
			 showToastPosition('bottom-center','No Specimen','Please Enter The Specimen Brought','error'); 
		 }
		 else {
			 var req = $.ajax({
				url:"formsubmit.php", data:{ add_this_specimen:'all',serial:serial,sample:elem_spec.val()}, method:"POST",beforeSend:function(){loader('show');} }); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ elem = $('.specimen_added'); display_my_specimen(elem);  loader('hide'); 
					var output = $.parseJSON(res); 
					 showToastPosition('bottom-center',output['title'],output['text'],output['icon']);					
				    });  
		 }
	 } 
	 
	 
	 function display_my_specimen(elem){
		    var req = $.ajax({
				url:"formsubmit.php", data:{ display_my_specimen:'all'}, method:"POST",beforeSend:function(){loader('show');} }); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ loader('hide'); 	elem.html(res); }); 
	 }
	
	function display_my_final_specimen(elem){
		    var req = $.ajax({
				url:"formsubmit.php", data:{ display_my_final_specimen:'all'}, method:"POST",beforeSend:function(){loader('show');} }); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ loader('hide'); 	elem.html(res); }); 
	 }
	 
