	function display_bill_ticket(dept_id,categ_id,elem){
			var req = $.ajax({
				url:"formsubmit.php", data:{ display_bill_ticket:'all',dept_id:dept_id,categ_id:categ_id}, method:"POST" }); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ elem.html(res); loader('hide');  /** alert(res); **/ }); 
	}
