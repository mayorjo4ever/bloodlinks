	function  create_ticket(){
		// amount_paid = $('#amount_paid'); 
		comment = $('#comment'); 
		// alert('amount_paid :'+amount_paid.val()+' , comment :'+comment.val());
		var req = $.ajax({ // amount_paid:amount_paid.val(),
				url:"formsubmit.php", data:{ create_ticket:'this',comment:comment.val()}, method:"POST",beforeSend:function(){loader('show');}}); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ loader('hide'); // alert(res);   
					 var output = $.parseJSON(res); 
					 showToastPosition('bottom-center',output['title'],output['text'],output['icon']);	
					 if(output['icon']=="success") window.location.href="ticket_paym.php?nextact="+output['pay_id'];
					 display_my_final_specimen($('.final_specimen_form')); 
				   }); 
	}
	
