						}
					} break; 

					case "age": 
					 {
						if(value!="" && value.length>=1 ){
							//$('.'+id+'_text').text(name+' ok');
							$('.'+id+'_text').removeClass('border-danger').addClass('border-success');  
							$('#'+id).removeClass('border-danger').addClass('border-success');  
