				/**********************/
				displayer = $('.num_list');  
				if(search_text.length >=1) {  $.ajax({							
						url: 'formsubmit.php',
						type: 'POST',
						data: {auto_search_complete_ticket:"",keyword:search_text},
						beforeSend:function(){l.start(); /**  $('.search_result').html(''); **/},
						success:function(data){
							displayer.show();
							displayer.html(data);
							l.stop();
							// output function : set_ticket_found(name,id)  is defined at tickets.php 
						}
					}); 
					}
					else {
					displayer.hide(); // $('#patient_filter').attr('ref','');	 
				}
			});  
			/*****************/
			
		
		});		// jQuery
	
