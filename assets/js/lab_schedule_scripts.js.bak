		/*********************************************/	 
		 $('.viewtickets').on('click',function(){
			 datefrom  = $('#datefrom'); 
			 dateto  = $('#dateto'); 
			 elem = $('.ticket_results');
			 search_text = $('#comp_ticket_searcher'); 
			 process_status = 'yes';
			 search_type = $('input:radio.search_type:checked').val();  
			 // format of form to display - text_form | param_form
			 
			 switch(search_type){
				 case "text_form": {
					if(search_text.val()==""){
						showToastPosition('bottom-center',"Empty Ticket Number","Pleasse enter the ticket number","error"); 
					}  else {
						 var req = $.ajax({
							url:"formsubmit.php", data:{ search_this_comp_ticket:'all',process_status:process_status, ticket_no:search_text.val()}, method:"POST",beforeSend:function(){ elem.html("<i class='fa fa-spinner fa-spin fa-3x'></i>");} }); 
							req.fail(function(e){ console.log(" --- "+ e.status+" Failed"); elem.html(''); });
							req.done(function(res){ elem.html(res);  /** alert(res); **/ }); 				 
						} 
				 } break;
				 case "param_form": {
					 if(datefrom.val()==""){ datefrom.focus(); }
					 else if(dateto.val()==""){ dateto.focus(); }
					 else {
						 var req = $.ajax({
							url:"formsubmit.php", data:{ view_ticket_dates:'all',search_type:search_type,process_status:process_status, datefrom:datefrom.val(), dateto:dateto.val()}, method:"POST",beforeSend:function(){ elem.html("<i class='fa fa-spinner fa-spin fa-3x'></i>");} }); 
							req.fail(function(e){ console.log(" --- "+ e.status+" Failed"); elem.html(''); });
							req.done(function(res){ elem.html(res);  /** alert(res); **/ }); 				 
						} 
						
						} break; // end case param_form
					 } // end switch 
						
			});
		
		/******************************/
		$('#comp_ticket_searcher').on('keyup',function(){ 
				search_text = $(this).val();  elem = $('.search_result'); 
				/*********************/
