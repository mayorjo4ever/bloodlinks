				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ loader('hide');   // alert(res);    
					 elem.html(res);
				   }); 
	}
	
	function  view_tickets_to_modify(process_status,elem ){ 
