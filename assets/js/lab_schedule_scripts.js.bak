				url:"formsubmit.php", data:{ view_tickets_to_modify:'this',process_status:process_status}, method:"POST",beforeSend:function(){  elem.html("<i class='fa fa-spinner fa-spin fa-3x'></i>"); }}); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed"); loader('hide'); });
				req.done(function(res){ loader('hide');   // alert(res);    
					 elem.html(res);
				   }); 
	}
	
	function togInputDisabled(prop_status,input_elem){		
		if(prop_status==true) input_elem.prop('disabled',false);
		if(prop_status==false) input_elem.prop('disabled',true); 
	}
	
	//	($(this).prop('checked'),$('#specimen_template_form'))
	
	function togTemplateForm(prop_status,elem){		
		if(prop_status==true) elem.removeClass('invisible').addClass('visible');
		if(prop_status==false) elem.removeClass('visible').addClass('invisible');
	}
		
	function save_template_settings(){	 	
		bill_type_id = $('#ticket_specimens'); console.log(bill_type_id.val()); 
		result_name = $('#result_name'); 
		has_unit = $('input:checkbox#has_unit'); 
		unit = $('#unit');  ref_val = $('#ref_val');  age_range = $('#age_range');  
		has_ref_val = $('input:checkbox#has_ref_val'); //  console.log('has_unit : '+has_unit.prop('checked')); // console.log('has_ref_val : '+has_ref_val.prop('checked'));
		// 
		if(result_name.val()==""){
			result_name.removeClass('border-success border-primary ').addClass('border-danger');  
			showToastPosition('bottom-center','Empty Name','Please Enter the Result Name','error');	
		}
		else if(age_range.val()==""){
			age_range.removeClass('border-success border-primary ').addClass('border-danger');  
			showToastPosition('bottom-center','Empty Age range','Please Select the Age range','error');	
		}
		else if(has_unit.prop('checked')==true && unit.val()==""){
			unit.removeClass('border-success border-primary ').addClass('border-danger');  
			showToastPosition('bottom-center','Empty Unit Value','Please Enter the Unit Value','error');	
		}
		else if(has_ref_val.prop('checked')==true && ref_val.val()==""){
			ref_val.removeClass('border-success border-primary ').addClass('border-danger');  
			showToastPosition('bottom-center','Empty Reference Value','Please Enter the Reference Value','error');	
		}
		else{
			result_name.removeClass('border-danger border-primary ').addClass('border-success'); 
			age_range.removeClass('border-danger border-primary ').addClass('border-success'); 
			unit.removeClass('border-danger border-primary ').addClass('border-success'); 
			ref_val.removeClass('border-danger border-primary ').addClass('border-success');  
			/*********************/
			 var l = Ladda.create( document.querySelector('#save_template_settings'));
			/*********************/
			 var req = $.ajax({ 
				url:"formsubmit.php", data:{ save_template_settings:'this',name:result_name.val(),age_range:age_range.val(),bill_type_id:bill_type_id.val(),
				has_unit:has_unit.prop('checked'),has_ref_val:has_ref_val.prop('checked'), unit:unit.val(),ref_val:ref_val.val()}, method:"POST",beforeSend:function(){ l.start();  }}); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed");  l.stop(); });
				req.done(function(res){  var output = $.parseJSON(res);  l.stop(); 
					 showToastPosition('bottom-center',output['title'],output['text'],output['icon']);	
				   });  
			
		} // end validation  
	
	} // end function 
	function save_template_settings_2(mode,bill_type_id){	 	
		// bill_type_id = $('#save_template_settings_2,#update_template_settings_2').attr('for');  
		// mode : new / update 
		  
		temp_type = $('input:radio.form_type:checked').val();  // format of result - text_form | param_form
		elem = $('#result_template');  
		
		/*********************/ 
		
		result_name = $('#result_name'); 
		has_unit = $('input:checkbox#has_unit'); 
		unit = $('#unit');  ref_val = $('#ref_val');  age_range = $('#age_range');  
		has_ref_val = $('input:checkbox#has_ref_val'); //  console.log('has_unit : '+has_unit.prop('checked')); // console.log('has_ref_val : '+has_ref_val.prop('checked'));
		upd_serial = $('#update_template_settings_2').attr('data-text');
		
		/************ console.log(temp_type);  *********/ 
		
		switch(temp_type){ 
			case 'text_form': {
				 raw_text_val = tinymce.activeEditor.getContent();  // alert(raw_text_val); 				
				  if(raw_text_val==""){
					showToastPosition('bottom-center','Empty Word','Please Enter Sample of the raw Text value','error');	
				}
				else{
					/********************/ 
					 var l = Ladda.create( document.querySelector('#save_template_settings_2'));
					 var l2 = Ladda.create( document.querySelector('#update_template_settings_2'));
					/*******************/
					var req = $.ajax({ 
				url:"formsubmit.php", data:{ save_template_settings:'this',raw_text_val:raw_text_val,temp_type:temp_type,bill_type_id:bill_type_id,mode:mode, upd_serial:upd_serial, 
				   }, method:"POST",beforeSend:function(){ l.start(); l2.start(); console.log('sending raw text values'); }}); 
				req.fail(function(e){ console.log(" --- "+e.status+" Failed");  l.stop();l2.stop(); });
				req.done(function(res){  var output = $.parseJSON(res);  l.stop(); l2.stop(); 
					 showToastPosition('bottom-center',output['title'],output['text'],output['icon']);	
					 view_bill_result_template(bill_type_id,elem); 
				   });
				 }  
				} break;  /** end case **/
			case 'param_form': { 
					unit_val = tinymce.activeEditor.getContent(); 
				if(result_name.val()==""){
					result_name.removeClass('border-success border-primary ').addClass('border-danger');  
					showToastPosition('bottom-center','Empty Name','Please Enter the Result Name','error');	
				}
				else if(age_range.val()==""){
					age_range.removeClass('border-success border-primary ').addClass('border-danger');  
					showToastPosition('bottom-center','Empty Age range','Please Select the Age range','error');	
				}
				else if(has_unit.prop('checked')==true && unit_val ==""){
					unit.removeClass('border-success border-primary ').addClass('border-danger');  
					showToastPosition('bottom-center','Empty Unit Value','Please Enter the Unit Value','error');	
				}
				else if(has_ref_val.prop('checked')==true && ref_val.val()==""){
					ref_val.removeClass('border-success border-primary ').addClass('border-danger');  
					showToastPosition('bottom-center','Empty Reference Value','Please Enter the Reference Value','error');	
				}
				else{
					result_name.removeClass('border-danger border-primary ').addClass('border-success'); 
					age_range.removeClass('border-danger border-primary ').addClass('border-success'); 
					unit.removeClass('border-danger border-primary ').addClass('border-success'); 
					ref_val.removeClass('border-danger border-primary ').addClass('border-success');  
					/*********************/
					 var l = Ladda.create( document.querySelector('#save_template_settings_2'));
					 var l2 = Ladda.create( document.querySelector('#update_template_settings_2'));
					/*********************/
					 var req = $.ajax({ 
						url:"formsubmit.php", data:{ save_template_settings:'this',temp_type:temp_type,name:result_name.val(),age_range:age_range.val(),bill_type_id:bill_type_id,mode:mode, upd_serial:upd_serial, 
						has_unit:has_unit.prop('checked'),has_ref_val:has_ref_val.prop('checked'), unit:unit_val,ref_val:ref_val.val()}, method:"POST",beforeSend:function(){ l.start(); l2.start(); console.log('has_ref_val = '+has_ref_val.prop('checked')+', has_unit = '+has_unit.prop('checked')); }}); 
						req.fail(function(e){ console.log(" --- "+e.status+" Failed");  l.stop();l2.stop(); });
						req.done(function(res){  var output = $.parseJSON(res);  l.stop(); l2.stop(); 
							 showToastPosition('bottom-center',output['title'],output['text'],output['icon']);	
							 view_bill_result_template(bill_type_id,elem); 
						   });  
					
					} // end validation  
				} break;  /** end case **/
		} /** end switch **/
	
	} // end function 
	
	function update_specimen_template(data_text){
		$('input:radio.param_form').click();
		infos = data_text.split('|'); //  age_range , name , unit , ref_val , bill_type_id , upd_serial, has_unit , has_ref_val , 		 
		$('select#age_range option[value="' + infos[0]+'"]').prop('selected', true);
		$('#result_name').val(infos[1]);		
		// $('#unit').val(infos[2]);
		// tinymce.get('unit').setContent(infos[2]);	
		tinymce.activeEditor.setContent(infos[2]);
		$('#ref_val').val(infos[3]);
		$('#save_template_settings_2').attr('for',infos[4]); 
		$('#update_template_settings_2').attr('data-text',infos[5]); 
		show_update_buttons(); 
	}
	
