	function  view_ticket_analysis(ticket_no,comp_status,elem){
		var req = $.ajax({
				url:"formsubmit.php", data:{ view_ticket_analysis:'all',ticket_no:ticket_no,comp_status:comp_status}, method:"POST",beforeSend:function(){ elem.html("<i class='fa fa-spinner fa-spin fa-3x'></i>");} }); 
				req.fail(function(e){ console.log(" --- "+ e.status+" Failed"); elem.html(''); });
				req.done(function(res){ elem.html(res);  /** alert(res); **/ }); 
	}
	/*********    *****************/
	function  finalize_test_process(ticket_no,data_text){
		// alert(ticket_no+' --- and --- '+data_text);
		comment = $('#comment').val(); 
		alt_test_name = $('#alt_test_name').val(); 
		processes = data_text.split('|'); // yes or no 
		
		if($.inArray('no',processes) !==-1) swal('Cannot Finalize Now','Reason : All the test result has not been computed','error');
		
		else { 
			// finalize the report 
			/*********************/
			 var l = Ladda.create( document.querySelector('#finalize_test_process'));
			/*********************/
			var req = $.ajax({
				url:"formsubmit.php", data:{ finalize_test_process:'all',ticket_no:ticket_no,comment:comment,alt_test_name:alt_test_name}, method:"POST",beforeSend:function(){ l.start(); } }); 
				req.fail(function(e){ console.log(" --- "+ e.status+" Failed");  l.stop();  });
				req.done(function(res){  l.stop();   
					var output = $.parseJSON(res); 
					 // showToastPosition('bottom-center',output['title'],output['text'],output['icon']);					
					 swal(output['title'],output['text'],output['icon']);					
					 if(output['icon']=="success") { window.location.href=output['href']; }
				/*** alert() ***/ }); 
		}   
		
	}
	/************** functions ***************/	
	function print_results(ticket_no){ 
		specimens = []; 
		$("input:checkbox.specimen_results_check:checked").each(function() {
			specimens.push($(this).val());
		});
		if(specimens.length==0){ swal({title:'No Completed Result Was Selected',icon:'error'}); }
		 else {
			  $(this).target = "_blank";
				/// var url = "tick_result_part_print.php?r_val="+ ticket_no+'&spc='+specimens;
				var url = "tick_result_part_print.php?r_val="+ ticket_no+'&spc='+specimens;
				// window.open($(this).prop('href'));
				$("input:checkbox.specimen_results_check").iCheck('uncheck');
				window.open(url);// part_prints
			 
		 }
	}
	/************** functions ***************/	
	function download_results(ticket_no){ 
		specimens = []; 
		$("input:checkbox.specimen_results_check:checked").each(function() {
			specimens.push($(this).val());
		});
		if(specimens.length==0){ swal({title:'No Completed Result Was Selected',icon:'error'}); }
		 else {
			  $(this).target = "_blank";
				/// var url = "tick_result_part_print.php?r_val="+ ticket_no+'&spc='+specimens;
				var url = "tick_result_part_dnld.php?r_val="+ ticket_no+'&spc='+specimens;
				// window.open($(this).prop('href'));
				$("input:checkbox.specimen_results_check").iCheck('uncheck');
				window.open(url);// part_prints
			 
		 }
	}
