	function update_specimen_text_template(data_text,upd_ref){
		  $('input:radio.text_form').click(); 
			// tinymce.get('result_text').focus();
			var ed = tinymce.activeEditor;
			ed.setProgressState(1);
			window.setTimeout(function(){  
			   ed.setProgressState(0); 
			   ed.setContent(data_text); 
			 // alert('id = '+ed.id+', mode = '+ed.mode+', theme = '+ed.theme); 
			},500); 
		// show_update_buttons(); 
		
	}
	
	function save_specimen_result(){
		 var temps = [];	temp_id = [];	scores = []; 	test_comment =  $('#test_comment'); date_perform =  $('#date_perform');
		 var custom_bill_info = $('#save_specimen_result_btn').attr('data-text'); // ticket_no |  bill_type_id
		 proceed = true; 
			$("input:checkbox.stud_box:checked").each(function() {
				temps.push($(this).val());
			});
		 if(temps.length == 0 ) {
				swal('empty result','Please ensure you select the result type to save','warning' ); 
				proceed = false; 
				return false; 
			}
			else if(date_perform.val()==""){
				swal('No Date Performed','Please ensure you select the date perfomed','warning' ); 
				proceed = false; 
				return false; 
			}
			else{
				$("input:checkbox.stud_box:checked").each(function() {
					 var txt = $(this).closest('tr').find('input[type=text]');
						if (txt.val() == "") {							
							txt.removeClass('border-success').addClass('border-danger'); //textbox is empty							
							proceed = false; txt.focus();  
						} 
						else {
							/****** save all results ***********/   
							temp_id.push($(this).val());
							scores.push(txt.val()); 
							/*******************************/
							txt.removeClass('border-danger').addClass('border-success');							 					 
						}
				}); // end forEach 
				
				if(proceed == true){
					/**********************/
					
					var l = Ladda.create( document.querySelector('#save_specimen_result_btn'));
					l.start(); 
					/**********************/
					var req = $.ajax({
							url:"formsubmit.php", data:{ save_specimen_spreadsheet:'this',test_comment:test_comment.val(),
							temp_id:temp_id, scores:scores,custom_bill_info:custom_bill_info, date_perform:date_perform.val() }, method:"POST",
							beforeSend: function(){ l.start(); } });  
							
						req.fail(function(e){ console.log(" --- "+e.status+" Failed"); l.stop(); });
						req.done(function(res){  var output = $.parseJSON(res);  l.stop(); 
							showToastPosition('bottom-center',output['title'],output['text'],output['icon']);
							}); 
						/**********/
				} // end if true 		
				
			}
	}
	
	function save_specimen_text_result(){		
		 var custom_bill_info = $('#save_specimen_text_result_btn').attr('data-text'); // ticket_no |  bill_type_id
		 var date_perform = $('#date_perform_text').val();
		 // alert(custom_bill_info); 
			/**********************/
			result = tinymce.activeEditor.getContent(); 	
				var l = Ladda.create( document.querySelector('#save_specimen_text_result_btn'));			
				/**********************/
				// alert(result);
					var req = $.ajax({
						url:"formsubmit.php", data:{ save_specimen_text_result:'this',
						custom_bill_info:custom_bill_info,result:result,date_perform:date_perform }, method:"POST",
						beforeSend: function(){   l.start(); 
						} });  
						
					req.fail(function(e){ console.log(" --- "+e.status+" Failed"); l.stop(); });
					req.done(function(res){  var output = $.parseJSON(res);  l.stop(); 
						showToastPosition('bottom-center',output['title'],output['text'],output['icon']);
					}); 
				/**********/ 
	}
